    {
      "id": "T-0998",
      "user_id": "U-101",
      "subject": "Счёт за сентябрь без реквизитов компании",
      "status": "resolved",
      "priority": "low",
      "channel": "email",
      "created_at": "2026-10-02T12:10:00Z",
      "updated_at": "2026-10-03T08:45:00Z",
      "tags": ["billing"],
      "messages": [
        { "at": "2026-10-02T12:10:00Z", "from": "customer", "text": "В счёте за сентябрь нет названия компании и ИНН. Можно исправить?" },
        { "at": "2026-10-03T08:45:00Z", "from": "agent", "text": "Выставленный счёт изменить нельзя, но если указать реквизиты в Settings → Billing, они будут во всех следующих счетах." }
      ],
      "notes": [
        { "at": "2026-10-03T08:44:00Z", "author": "agent:maria", "text": "Объяснила, что счета не меняются после выставления. Клиентка добавила реквизиты." }
      ]
    },
